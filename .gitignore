# ---- Conda / virtual environments (never track an environment) ----
.conda/
.venv*/
venv/
env/

# ---- Python bytecode / caches ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---- Editors / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Experiment / runtime outputs ----
runs/              # Ultralytics YOLO training/inference outputs
outputs/
wandb/
*.log

# ---- Large intermediate artifacts (regenerated by the pipeline) ----
# Kept out of git; see data/README.md. Committed sample data is under data/.
scratch/
tmp/
