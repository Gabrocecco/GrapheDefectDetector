# Normalize line endings for text files regardless of platform.
* text=auto eol=lf

# Explicit binary types — never touch line endings, never diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.pt binary
*.pyc binary

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Jupyter notebooks: treat as text but avoid noisy diffs on outputs.
*.ipynb text -diff
